FROM alpine:3.22 AS download

ARG TARGETARCH

RUN apk add --no-cache ca-certificates curl unzip

WORKDIR /tmp/pocketbase

COPY apps/pocketbase/.pocketbase-version ./version

RUN set -eu; \
	PB_VERSION="$(tr -d '\r\n' < version)"; \
	case "${TARGETARCH}" in \
		amd64|arm64) PB_ARCH="${TARGETARCH}" ;; \
		*) echo "Unsupported PocketBase target architecture: ${TARGETARCH}" >&2; exit 1 ;; \
	esac; \
	curl --fail --location --silent --show-error \
		"https://github.com/pocketbase/pocketbase/releases/download/v${PB_VERSION}/pocketbase_${PB_VERSION}_linux_${PB_ARCH}.zip" \
		--output pocketbase.zip; \
	unzip -q pocketbase.zip pocketbase -d /out; \
	chmod 0755 /out/pocketbase

FROM alpine:3.22 AS runtime

RUN apk add --no-cache ca-certificates \
	&& addgroup -S -g 10001 pocketbase \
	&& adduser -S -D -H -u 10001 -G pocketbase pocketbase \
	&& mkdir -p /data /pb \
	&& chown 10001:10001 /data

COPY --from=download /out/pocketbase /usr/local/bin/pocketbase
COPY apps/pocketbase/pb_migrations/ /pb/pb_migrations/
COPY apps/pocketbase/pb_hooks/ /pb/pb_hooks/

USER 10001:10001

VOLUME ["/data"]
EXPOSE 8090

ENTRYPOINT ["/usr/local/bin/pocketbase"]
CMD ["serve", "--http=0.0.0.0:8090", "--dir=/data", "--migrationsDir=/pb/pb_migrations", "--hooksDir=/pb/pb_hooks", "--encryptionEnv=PB_ENCRYPTION_KEY", "--hooksWatch=false"]