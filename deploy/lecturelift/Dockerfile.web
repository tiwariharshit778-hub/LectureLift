FROM node:22.22.0-bookworm-slim AS build

WORKDIR /workspace

COPY package.json package-lock.json ./
COPY apps/web/package.json ./apps/web/package.json
COPY apps/pocketbase/package.json ./apps/pocketbase/package.json

RUN npm ci

COPY apps/web ./apps/web

RUN npm run build
RUN npm prune --omit=dev

FROM node:22.22.0-bookworm-slim AS runtime

WORKDIR /app/apps/web

ENV NODE_ENV=production \
	HOST=0.0.0.0 \
	PORT=3000

COPY --from=build --chown=node:node /workspace/node_modules /app/node_modules
COPY --from=build --chown=node:node /workspace/package.json /app/package.json
COPY --from=build --chown=node:node /workspace/apps/web/package.json /app/apps/web/package.json
COPY --from=build --chown=node:node /workspace/dist/apps/web /app/dist/apps/web
COPY --from=build --chown=node:node /workspace/apps/web/public /app/apps/web/public

USER node

EXPOSE 3000

CMD ["node", "/app/node_modules/@react-router/serve/bin.cjs", "/app/dist/apps/web/server/index.js"]