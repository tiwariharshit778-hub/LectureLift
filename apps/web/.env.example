WHISPER_BASE_URL=http://127.0.0.1:8765
WHISPER_API_KEY=replace-with-local-whisper-token
WHISPER_MODEL=large-v3-turbo
WHISPER_LOCAL_ONLY=true

ANTHROPIC_API_KEY=replace-with-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_WORKSPACE_ID=replace-with-workspace-id
GROQ_API_KEY=replace-with-groq-api-key
GROQ_MODEL=whisper-large-v3-turbo

POCKETBASE_URL=http://127.0.0.1:8090
PB_SUPERUSER_EMAIL=replace-with-pocketbase-superuser-email
PB_SUPERUSER_PASSWORD=replace-with-pocketbase-superuser-password
PB_ENCRYPTION_KEY=replace-with-pocketbase-encryption-key